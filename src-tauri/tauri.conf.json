{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FONarch",
  "version": "1.0.0",
  "identifier": "official.mickjay.fonarch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FONarch",
        "width": 512,
        "height": 384,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#ffb000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": ["../assets/fonts/FreeLicense.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Michael Jones (2747T4ZEJ9)"
    }
  }
}
